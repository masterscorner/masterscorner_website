# Copy to .env for local development. Never commit .env.
# Local database started by `npm run db:dev`
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# 32+ random characters, e.g. from: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=
ORIGIN=http://localhost:5173
# console = login codes are printed in the terminal; msg91 = real SMS
OTP_SENDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_MAPS_KEY=
