{
	"name": "masterscorner",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"db:dev": "node scripts/dev-db.ts",
		"db:migrate": "node scripts/migrate.ts",
		"db:seed": "node scripts/seed.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"budget": "node scripts/bundle-budget.ts",
		"deploy": "vite build && wrangler deploy",
		"photos": "node scripts/download-photos.ts",
		"sample:add": "node scripts/sample-data.ts add",
		"sample:remove": "node scripts/sample-data.ts remove"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/plus-jakarta-sans": "5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"better-auth": "1.7.11",
		"idb-keyval": "6.3.0",
		"kysely": "0.29.7",
		"kysely-postgres-js": "5.0.1",
		"postgres": "3.4.9",
		"uqr": "0.1.3",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.10",
		"@electric-sql/pglite-postgis": "0.2.10",
		"@electric-sql/pglite-socket": "0.2.13",
		"@lucide/svelte": "1.59.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"wrangler": "4.151.2"
	}
}
